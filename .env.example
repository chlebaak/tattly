# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL=

# Auth.js (Google OAuth – login + Calendar scope v jednom toku)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ENCRYPTION_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend (e-maily)
RESEND_API_KEY=
EMAIL_FROM=Tattly <onboarding@resend.dev>

# Mapy.cz (suggest adres a měst)
MAPY_CZ_API_KEY=

# Volitelné: přepíše adresu Fio API (používá se jen v testech)
# FIO_API_BASE=https://fioapi.fio.cz/v1/rest

# Inngest (asynchronní úlohy)
# Pozor: INNGEST_DEV=1 patří POUZE pro lokální vývoj.
# Na Vercelu tuto proměnnou nikdy nenastavujte!
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
