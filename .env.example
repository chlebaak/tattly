# App
# Produkce: https://tvoje-domena.cz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres)
# Produkce: pooled connection string pro runtime.
# Migrace spouštěj proti direct URL, ne proti pooled.
DATABASE_URL=

# Auth.js (Google OAuth – login + Calendar scope v jednom toku)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Produkce: https://tvoje-domena.cz, případně AUTH_TRUST_HOST=true
AUTH_URL=
AUTH_TRUST_HOST=
ENCRYPTION_KEY=

# Provozovatel pro právní stránky (fyzická osoba bez IČO nemusí IČO vyplňovat)
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_ICO=
LEGAL_EFFECTIVE_DATE=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend (e-maily)
RESEND_API_KEY=
# Produkce: adresa na ověřené doméně v Resendu, ne onboarding@resend.dev.
EMAIL_FROM=Tattly <onboarding@resend.dev>

# Mapy.cz (suggest adres a měst)
MAPY_CZ_API_KEY=

# Volitelné: přepíše adresu Fio API (používá se jen v testech)
# FIO_API_BASE=https://fioapi.fio.cz/v1/rest

# Inngest (asynchronní úlohy)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Lokálně lze použít INNGEST_DEV=1. V produkci tuto proměnnou nikdy nenastavujte!
# INNGEST_DEV=1
